<Window x:Class="JobSearchApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Height="600" Width="960" MinHeight="480" MinWidth="760"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Řádek 1: uzamčené e-maily + reset -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="Komunikační e-mail aplikace" FontSize="11" Foreground="Gray"/>
                <TextBox Text="{Binding AppEmail}" IsReadOnly="True" Background="#F1EFE8"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                <TextBlock Text="E-mail pro upozornění a odpovědi" FontSize="11" Foreground="Gray"/>
                <TextBox Text="{Binding UserEmail}" IsReadOnly="True" Background="#F1EFE8"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="{Binding ConnectionStatus}" FontSize="11" Foreground="Gray"
                           HorizontalAlignment="Right" Margin="0,0,0,3"/>
                <Button Content="Změnit nastavení" Command="{Binding ResetCommand}"
                        Padding="10,4"/>
            </StackPanel>
        </Grid>

        <!-- Řádek 2: filtry -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0" Width="180" Margin="0,0,8,0"
                      ItemsSource="{Binding Professions}"
                      SelectedItem="{Binding SelectedProfession}"/>

            <ToggleButton Grid.Column="1" x:Name="PortalsToggle" Content="Pracovní portály"
                          Width="160" Padding="6,4"/>
            <Popup PlacementTarget="{Binding ElementName=PortalsToggle}"
                   IsOpen="{Binding IsChecked, ElementName=PortalsToggle}"
                   StaysOpen="False" Placement="Bottom">
                <Border Background="White" BorderBrush="Gray" BorderThickness="1" Padding="8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="Vybrat vše" Command="{Binding SelectAllPortalsCommand}"
                                    Margin="0,0,6,0" Padding="6,2"/>
                            <Button Content="Zrušit výběr" Command="{Binding SelectNonePortalsCommand}"
                                    Padding="6,2"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Portals}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Popup>

            <Button Grid.Column="3" Content="Aktualizovat nabídky" Command="{Binding RefreshCommand}" Padding="12,4"/>
        </Grid>

        <!-- Tabulka inzerátů -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding JobListings}" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single"
                  GridLinesVisibility="Horizontal" AlternatingRowBackground="#F7F7F7">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Firma" Binding="{Binding Company}" Width="*"/>
                <DataGridTextColumn Header="Pozice" Binding="{Binding Position}" Width="*"/>
                <DataGridTextColumn Header="Profese" Binding="{Binding Profession}" Width="120"/>
                <DataGridTextColumn Header="Portál" Binding="{Binding Portal}" Width="110"/>
                <DataGridTextColumn Header="Datum" Binding="{Binding DateFound, StringFormat=d.M.yyyy}" Width="90"/>
                <DataGridHyperlinkColumn Header="Odkaz" Binding="{Binding Url}" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="Gray"
                   FontSize="11" Margin="0,8,0,0"/>
    </Grid>
</Window>
